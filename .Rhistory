# --- 1. Create Simulated Community Data ---
set.seed(123)
my_community_data <- data.frame(
Season = rep(c("Spring", "Summer", "Autumn", "Winter"), each = 15),
Diatoms = round(runif(60, 10, 100)),
Chlorophytes = round(runif(60, 5, 60)),
Cyanobacteria = round(runif(60, 0, 40))
)
# --- 2. Run the Function ---
res_biplot <- pca_community_biplot(
data = my_community_data,
group_col = "Season",
arrow_multiplier = 1.5 # Scaling arrows slightly for better visibility
)
# --- 3. View the Result ---
print(res_biplot$Plot)
# --- 1. Create Simulated Environmental Data ---
set.seed(456)
my_env_data <- data.frame(
Season = rep(c("Spring", "Summer", "Autumn", "Winter"), each = 15),
Temp_C = runif(60, 15, 32),
Salinity_ppt = runif(60, 5, 25),
DO_mgL = runif(60, 4, 9),
pH = runif(60, 6.5, 8.5),
Turbidity_NTU = runif(60, 10, 80)
)
# --- 2. Run the Function ---
# We tell the function to exclude the "Season" column so it only analyzes the numeric water quality data
res_circle <- pca_correlation_circle(
data = my_env_data,
exclude_cols = "Season"
)
# --- 3. View the Result ---
print(res_circle$Plot)
# You can also check the variance table your function generates:
print(res_circle$Variance_Summary)
devtools::load_all()
# Run the constrained RDA using BOTH datasets
res_rda <- rda_analysis(
comm_data = my_community_data,
env_data = my_env_data,
group_col = "Season",
species_arrow_mult = 1.2, # slightly lengthen species arrows
env_arrow_mult = 1.5      # slightly lengthen env arrows
)
# 1. View the Triplot!
print(res_rda$Plot)
# 2. Check if the environmental variables significantly drove community structure
print(res_rda$Model_Significance)
# 3. Check which specific water quality parameters were statistically significant drivers
print(res_rda$Variable_Significance)
