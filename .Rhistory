hilsa_env$High_Catch <- ifelse(hilsa_env$Catch_kg > median(hilsa_env$Catch_kg, na.rm = TRUE), 1, 0)
# Run a Binomial Logistic Regression (Odds Ratios)
res_binomial <- glm_analysis(
data = hilsa_env,
response_var = "High_Catch",     # Binary response (0 or 1)
predictor_vars = c("SST_C", "Salinity_ppt"),
family_type = "binomial",
color_palette = "Set2"
)
