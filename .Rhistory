usethis::use_version()
# --- Automated MASS Import Stripper & Function Scanner ---
r_files <- list.files("R", pattern = "\\.R$", full.names = TRUE)
# 1. Automatically remove @import MASS from roxygen headers
for (f in r_files) {
lines <- readLines(f, warn = FALSE)
if (any(grepl("@import\\s+.*\\bMASS\\b", lines))) {
# Remove lines containing MASS in @import directives
new_lines <- lines[!grepl("@import\\s+.*\\bMASS\\b", lines)]
writeLines(new_lines, f)
cat(sprintf("✨ Removed @import MASS from: %s\n", basename(f)))
}
}
# 2. Scan for any un-prefixed MASS function calls
mass_funcs <- c("glm.nb", "lda", "qda", "mvrnorm", "boxcox", "stepAIC", "ginv")
cat("\nScanning for un-prefixed MASS function calls...\n")
found_mass <- FALSE
for (f in r_files) {
lines <- readLines(f, warn = FALSE)
for (i in seq_along(lines)) {
for (func in mass_funcs) {
pattern <- paste0("\\b", func, "\\s*\\(")
if (grepl(pattern, lines[i]) && !grepl(paste0("MASS::", func), lines[i])) {
cat(sprintf("📁 File: %s | Line %d: Found un-prefixed '%s'\n", basename(f), i, func))
found_mass <- TRUE
}
}
}
}
if (!found_mass) {
cat("✨ No un-prefixed MASS function calls found in your code!\n")
}
document()
check()
# --- Automated dplyr Import Refactorer ---
r_files <- list.files("R", pattern = "\\.R$", full.names = TRUE)
# 1. Replace blanket @import dplyr with selective safe imports
for (f in r_files) {
lines <- readLines(f, warn = FALSE)
# Check if file has blanket @import dplyr
if (any(grepl("^\\s*#\\s*@import\\s+dplyr\\b", lines))) {
# Replace with selective imports that exclude filter and lag
lines <- gsub("^\\s*#\\s*@import\\s+dplyr\\b", "#' @importFrom dplyr mutate summarise group_by ungroup select arrange", lines)
writeLines(lines, f)
cat(sprintf("🔄 Refactored @import dplyr in: %s\n", basename(f)))
}
}
# 2. Scan for any bare filter() or lag() calls that might need explicit scoping
cat("\nScanning for bare filter() or lag() calls...\n")
found_bare <- FALSE
for (f in r_files) {
lines <- readLines(f, warn = FALSE)
for (i in seq_along(lines)) {
if (grepl("\\b(filter|lag)\\s*\\(", lines[i]) && !grepl("(dplyr|stats)::", lines[i])) {
cat(sprintf("📁 File: %s | Line %d: %s\n", basename(f), i, trimws(lines[i])))
found_bare <- TRUE
}
}
}
if (!found_bare) {
cat("✨ No bare filter() or lag() calls found!\n")
} else {
cat("\n👉 Tip: For any flagged lines above, change them to dplyr::filter() or dplyr::lag() if they belong to dplyr.\n")
}
document()
check()
packageVersion("sessioninfo")
