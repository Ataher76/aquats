vignette_path <- "vignettes/aquats-tutorial.Rmd"
lines <- readLines(vignette_path, encoding = "UTF-8")
# Find the YAML delimiter boundaries
yaml_bounds <- which(lines == "---")
if (length(yaml_bounds) >= 2) {
clean_yaml <- c(
"---",
'title: "Comprehensive Ecological and Fisheries Data Analysis with aquats"',
'author: "Ataher Ali and Mohammed Shahidul Alam"',
'date: "`r Sys.Date()`"',
"output:",
"  rmarkdown::html_vignette:",
"    toc: true",
"    toc_depth: 2",
"    number_sections: true",
"vignette: >",
"  %\\VignetteIndexEntry{Comprehensive Ecological and Fisheries Data Analysis with aquats}",
"  %\\VignetteEngine{knitr::rmarkdown}",
"  %\\VignetteEncoding{UTF-8}",
"---"
)
new_content <- c(clean_yaml, lines[(yaml_bounds[2] + 1):length(lines)])
writeLines(new_content, vignette_path, useBytes = TRUE)
message("YAML header in '", vignette_path, "' successfully cleaned and updated.")
}
tools::buildVignettes(dir = ".")
