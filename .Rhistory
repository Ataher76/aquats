# --- Automated Function Conflict & Bare Call Finder ---
r_files <- list.files("R", pattern = "\\.R$", full.names = TRUE)
target_funcs <- c("select", "filter", "lag")
cat("Scanning R/ scripts for un-prefixed function calls...\n\n")
found_any <- FALSE
for (f in r_files) {
lines <- readLines(f, warn = FALSE)
for (i in seq_along(lines)) {
line <- lines[i]
for (func in target_funcs) {
# Check if function is called (e.g., select(...) or filter(...))
if (grepl(paste0("\\b", func, "\\s*\\("), line)) {
# Check if it lacks a namespace prefix like dplyr::, stats::, or MASS::
if (!grepl(paste5 <- paste0("(?:dplyr|stats|MASS|base)::", func), line, perl = TRUE)) {
cat(sprintf("📁 File: %s\n   Line %d: %s\n\n", basename(f), i, trimws(line)))
found_any <- TRUE
}
}
}
}
}
if (!found_any) {
cat("✨ No un-prefixed calls found! All target functions are already namespaced.\n")
}
