# --- Find and strip blanket @import dplyr and @import stats ---
r_files <- list.files("R", pattern = "\\.R$", full.names = TRUE)
for (f in r_files) {
lines <- readLines(f, warn = FALSE)
# Check if file has blanket @import dplyr or @import stats
if (any(grepl("^\\s*#\\s*@import\\s+(dplyr|stats)\\b", lines))) {
cat(sprintf("📁 Found blanket import in: %s\n", basename(f)))
# Remove the blanket import lines
new_lines <- lines[!grepl("^\\s*#\\s*@import\\s+(dplyr|stats)\\b", lines)]
writeLines(new_lines, f)
cat(sprintf("✨ Removed blanket import from: %s\n", basename(f)))
}
}
