vpath <- "vignettes/aquats-tutorial.Rmd"
raw_lines <- readLines(vpath, encoding = "UTF-8", warn = FALSE)
# 1. Identify the boundaries of the YAML header
bounds <- which(trimws(raw_lines) == "---")
if (length(bounds) < 2) stop("Could not find opening/closing --- YAML markers")
# 2. Define the validated YAML block
clean_yaml <- c(
"---",
'title: "Comprehensive Ecological and Fisheries Data Analysis with aquats"',
'author: "Ataher Ali and Mohammed Shahidul Alam"',
'date: "`r Sys.Date()`"',
"vignette: >",
"  %\\VignetteIndexEntry{Comprehensive Ecological and Fisheries Data Analysis with aquats}",
"  %\\VignetteEngine{knitr::rmarkdown}",
"  %\\VignetteEncoding{UTF-8}",
"output:",
"  rmarkdown::html_vignette:",
"    toc: true",
"    toc_depth: 2",
"    number_sections: true",
"---"
)
# 3. Write directly to disk
new_doc <- c(clean_yaml, raw_lines[(bounds[2] + 1):length(raw_lines)])
writeLines(new_doc, vpath, useBytes = TRUE)
message("--> vignettes/aquats-tutorial.Rmd successfully updated on disk.")
# 4. Check the first 14 lines written to verify line 10
head(readLines(vpath, encoding = "UTF-8"), 14)
devtools::document()
devtools::install(quick = T)
tools::buildVignettes(dir = ".")
library(devtools)
check()
vpath <- "vignettes/aquats-tutorial.Rmd"
doc <- readLines(vpath, encoding = "UTF-8", warn = FALSE)
# 1. Identify all occurrences of '---'
dashes <- which(trimws(doc) == "---")
cat("Found '---' at line indices:", paste(dashes, collapse = ", "), "\n")
# 2. Keep the first two as the YAML header; replace any body dividers with '***'
if (length(dashes) > 2) {
body_dividers <- dashes[3:length(dashes)]
doc[body_dividers] <- "***"
cat("Replaced", length(body_dividers), "body '---' divider(s) with '***'.\n")
}
# 3. Ensure the top YAML frontmatter is clean and valid
clean_yaml <- c(
"---",
'title: "Comprehensive Ecological and Fisheries Data Analysis with aquats"',
'author: "Ataher Ali and Mohammed Shahidul Alam"',
'date: "`r Sys.Date()`"',
"vignette: >",
"  %\\VignetteIndexEntry{Comprehensive Ecological and Fisheries Data Analysis with aquats}",
"  %\\VignetteEngine{knitr::rmarkdown}",
"  %\\VignetteEncoding{UTF-8}",
"output:",
"  rmarkdown::html_vignette:",
"    toc: true",
"    toc_depth: 2",
"    number_sections: true",
"---"
)
# Replace lines 1 through dashes[2] with the clean header
final_doc <- c(clean_yaml, doc[(dashes[2] + 1):length(doc)])
# 4. Write back to disk
writeLines(final_doc, vpath, useBytes = TRUE)
cat("--> vignettes/aquats-tutorial.Rmd successfully sanitized.\n")
# 5. Build vignettes
tools::buildVignettes(dir = ".")
check()
devtools::build()
submit_cran()
