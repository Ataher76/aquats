library(ggplot2)
library(dplyr)
library(RColorBrewer)
source("R/regression_analysis.R")
res_reg <- regression_analysis(
data = hilsa_regression,
x_var = "Total_Length_cm",
y_var = "Weight_g",
fit_type = "logarithmic",
group_var = "Habitat",
color_palette = "Set1"
)
print(res_reg$Plot)
res_reg <- regression_analysis(
data = hilsa_regression,
x_var = "Total_Length_cm",
y_var = "Weight_g",
fit_type = "logarithmic",
group_var = "Habitat",
color_palette = "Set1"
)
print(res_reg$Plot)
res_reg <- regression_analysis(
data = hilsa_regression,
x_var = "Total_Length_cm",
y_var = "Weight_g",
fit_type = "polynomial",
group_var = "Habitat",
color_palette = "Set1"
)
print(res_reg$Plot)
