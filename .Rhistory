set.seed(42)
diet_survey <- data.frame(
Life_Stage = sample(c("Juvenile", "Sub-Adult", "Adult"), 180, replace = TRUE, prob = c(0.4, 0.35, 0.25)),
Feeding_Guild = sample(c("Planktivore", "Benthivore", "Piscivore"), 180, replace = TRUE),
Prey_Type = sample(c("Copepods", "Chironomids", "Small Fish", "Macrophytes"), 180, replace = TRUE),
Biomass_g = round(runif(180, min = 0.5, max = 15.0), 2)
)
# 2. Multi-axis Sankey diagram weighted by ingested prey biomass
p_sankey <- plot_sankey(
data      = diet_survey,
axes      = c("Life_Stage", "Feeding_Guild", "Prey_Type"),
value     = "Biomass_g",
fill_axis = "Life_Stage",   # Colors flow ribbons by the initial life stage
palette   = "Dark2",
title     = "Trophic Ontogeny: Biomass Allocation Across Life Stages"
)
print(p_sankey)
