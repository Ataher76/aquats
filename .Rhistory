# --- Step 1: Set seed for reproducibility ---
set.seed(2026)
n_rows <- 120
# --- Step 2: Build hilsa_master ---
hilsa_master <- data.frame(
Habitat = factor(sample(c("Marine", "Estuary", "River"), n_rows, replace = TRUE, prob = c(0.33, 0.33, 0.34))),
Season = factor(sample(c("Monsoon", "Dry"), n_rows, replace = TRUE)),
Size_Class = factor(sample(c("Juvenile", "Adult"), n_rows, replace = TRUE)),
Weight_g = rnorm(n_rows, mean = 950, sd = 150),
Total_Length_cm = rnorm(n_rows, mean = 38, sd = 5),
Body_Depth_cm = rnorm(n_rows, mean = 12, sd = 2),
Head_Length_cm = rnorm(n_rows, mean = 8, sd = 1.2),
Fin_Length_cm = rnorm(n_rows, mean = 6, sd = 0.9),
Fishing_Hours = runif(n_rows, min = 2, max = 12),
Catch_Count = rpois(n_rows, lambda = 15),
SST_C = rnorm(n_rows, mean = 28, sd = 2),
Salinity_ppt = rnorm(n_rows, mean = 18, sd = 5),
Depth_m = rnorm(n_rows, mean = 25, sd = 8),
Catch_kg = rnorm(n_rows, mean = 50, sd = 15)
)
# Introduce realistic correlations (e.g., weight scales with length)
hilsa_master$Weight_g <- 15.5 * hilsa_master$Weight_g / mean(hilsa_master$Weight_g) * hilsa_master$Total_Length_cm + rnorm(n_rows, 0, 50)
hilsa_master$Weight_g <- abs(hilsa_master$Weight_g) + 400 # scale to realistic gram range
# --- Step 3: Build community_master list ---
# Generating 30 sample sites by default for community matrices
n_samples <- 30
phyto_comm <- data.frame(
Diatoms = rpois(n_samples, lambda = 45),
Cyanobacteria = rpois(n_samples, lambda = 25),
Chlorophytes = rpois(n_samples, lambda = 30)
)
rownames(phyto_comm) <- paste0("Site_", 1:n_samples)
zoo_comm <- data.frame(
Copepods = rpois(n_samples, lambda = 35),
Cladocerans = rpois(n_samples, lambda = 20),
Rotifers = rpois(n_samples, lambda = 15)
)
rownames(zoo_comm) <- paste0("Site_", 1:n_samples)
benthos_comm <- data.frame(
Chironomids = rpois(n_samples, lambda = 18),
Oligochaetes = rpois(n_samples, lambda = 12),
Molluscs = rpois(n_samples, lambda = 22)
)
rownames(benthos_comm) <- paste0("Site_", 1:n_samples)
community_master <- list(
Phytoplankton = phyto_comm,
Zooplankton = zoo_comm,
Benthos = benthos_comm
)
# --- Step 4: Save datasets into the package data/ folder ---
usethis::use_data(hilsa_master, community_master, overwrite = TRUE)
message("Success! Master datasets created and saved to package data directory.")
document()
